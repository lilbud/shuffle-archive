info=1&#038;iv_load_policy=1&#038;fs=1&#038;hl=en-US&#038;autohide=2&#038;wmode=transparent&#038;listType=playlist&#038;list=PLu8VBPtfGX1ApYyc8du5dIrWWdwS7Z72e\" allowfullscreen=\"true\" style=\"border:0;\" sandbox=\"allow-scripts allow-same-origin allow-popups allow-presentation allow-popups-to-escape-sandbox\"></iframe></span></div>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"23216\" data-permalink=\"https://estreetshuffle.com/1980-12-11/\" data-orig-file=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?fit=958%2C1756&amp;ssl=1\" data-orig-size=\"958,1756\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"1980-12-11\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?fit=559%2C1024&amp;ssl=1\" class=\"alignnone wp-image-23216 size-full\" src=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?resize=758%2C1389&#038;ssl=1\" alt=\"\" width=\"758\" height=\"1389\" srcset=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?w=958&amp;ssl=1 958w, https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?resize=164%2C300&amp;ssl=1 164w, https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?resize=559%2C1024&amp;ssl=1 559w, https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?resize=768%2C1408&amp;ssl=1 768w, https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1980-12-11.png?resize=838%2C1536&amp;ssl=1 838w\" sizes=\"auto, (max-width: 758px) 100vw, 758px\" /></p>\n<p><strong>1984:\u00a0</strong>Bruce and the E Street Band bring the Born in the U.S.A. Tour to Lexington, where they add &#8220;My Old Kentucky Home&#8221; to &#8220;Detroit Medley&#8221; for the occasion.</p>\n<div id=\"v-80rWaa1S-1\" class=\"video-player\"><iframe title='VideoPress Video Player' aria-label='VideoPress Video Player' width='758' height='426' src='https://videopress.com/embed/80rWaa1S?hd=1&amp;cover=1&amp;loop=0&amp;autoPlay=0&amp;permalink=1&amp;muted=0&amp;controls=1&amp;playsinline=0&amp;useAverageColor=0&amp;preloadContent=metadata' frameborder='0' allowfullscreen data-resize-to-parent=\"true\" allow='clipboard-write; presentation'></iframe></div>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"23217\" data-permalink=\"https://estreetshuffle.com/1984-12-11a/\" data-orig-file=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1984-12-11a.png?fit=2592%2C1138&amp;ssl=1\" data-orig-size=\"2592,1138\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"1984-12-11a\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1984-12-11a.png?fit=758%2C333&amp;ssl=1\" class=\"alignnone wp-image-23217 size-full\" src=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/11/1984-12-11a.png?resize=758%2C333&#038;ssl=1\" alt=\"\" width=\"758\" height=\"333\" srcset=\"https://i0.wp.com/estreetshuffle.com/wp-content/upl