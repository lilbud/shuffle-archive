layer\" width=\"758\" height=\"427\" src=\"https://www.youtube.com/embed/ftWhs8awKcU?version=3&#038;rel=1&#038;showsearch=0&#038;showinfo=1&#038;iv_load_policy=1&#038;fs=1&#038;hl=en-US&#038;autohide=2&#038;wmode=transparent\" allowfullscreen=\"true\" style=\"border:0;\" sandbox=\"allow-scripts allow-same-origin allow-popups allow-presentation allow-popups-to-escape-sandbox\"></iframe></span></div>\n<div class=\"jetpack-video-wrapper\"><span class=\"embed-youtube\" style=\"text-align:center; display: block;\"><iframe loading=\"lazy\" class=\"youtube-player\" width=\"758\" height=\"427\" src=\"https://www.youtube.com/embed/EU1YWRzDSpo?version=3&#038;rel=1&#038;showsearch=0&#038;showinfo=1&#038;iv_load_policy=1&#038;fs=1&#038;hl=en-US&#038;autohide=2&#038;wmode=transparent\" allowfullscreen=\"true\" style=\"border:0;\" sandbox=\"allow-scripts allow-same-origin allow-popups allow-presentation allow-popups-to-escape-sandbox\"></iframe></span></div>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"23443\" data-permalink=\"https://estreetshuffle.com/1992-12-27/\" data-orig-file=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/12/1992-12-27.png?fit=988%2C1312&amp;ssl=1\" data-orig-size=\"988,1312\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;0&quot;}\" data-image-title=\"1992-12-27\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/12/1992-12-27.png?fit=758%2C1007&amp;ssl=1\" class=\"alignnone wp-image-23443 size-full\" src=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/12/1992-12-27.png?resize=758%2C1007&#038;ssl=1\" alt=\"\" width=\"758\" height=\"1007\" srcset=\"https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/12/1992-12-27.png?w=988&amp;ssl=1 988w, https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/12/1992-12-27.png?resize=226%2C300&amp;ssl=1 226w, https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/12/1992-12-27.png?resize=771%2C1024&amp;ssl=1 771w, https://i0.wp.com/estreetshuffle.com/wp-content/uploads/2020/12/1992-12-27.png?resize=768%2C1020&amp;ssl=1 768w\" sizes=\"auto, (max-width: 758px) 100vw, 758px\" /></p>\n<p><strong>2017:\u00a0</strong>Patti Scialfa is sick with the flu, so Bruce continues playing the &#8220;B&#8221; setlist at\u00a0<em>Springsteen on Broadway\u00a0</em>at the Walter Kerr Theater in New York City.</p>\n", "protected": false}, "excerpt": {"rendered": "<p>The Born to Run and Darkness Tours wind down, and &#8220;Lost in the Flood&#8221; makes its last appearance for a quarter-century.</p>\n", "protected": false}, "author": 1, "featured_media": 14906, "comment_status": "open", "ping_status": "open", "sticky": false, "template": "", "format": "standard", "meta": {"_monsterinsights_skip_tracking": false, "_jetpack_newsletter_access": "", "_jetpack_dont_email_post_to_subs": false, "_jetpack_newsletter_tier_id": 0, "_jetpack_memberships_contains_paywalled_content": false, "_jetpack_feature_clip_id": 0, "_jetpack_memberships_contains_paid_content": false, "footnotes": "", "jetpack_publicize_message": "", "jetpack_publicize_feature_enabled": true, "jetpack_social_post_already_shared": true, "jetpack_social_options": {"image_generator_settings": {"template": "highway", "default_image_id": 0, "font": "", "enabled": false}, "version": 2}, "jetpack_post_was_ever_published": false}, "categories": [2], "tags": [2003, 1303, 1236, 534, 508, 289, 1047, 741, 606, 403, 10, 286, 68, 537, 87, 273, 11, 444], "class_list": ["post-63455", "post", "type-post", "status-publ